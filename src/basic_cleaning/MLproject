name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Fully-qualified name of the input W&B artifact to be cleaned (e.g. sample.csv:latest)
        type: string

      output_artifact:
        description: Name for the output (cleaned) artifact to be created and logged to W&B (e.g. clean_sample.csv)
        type: string

      output_type:
        description: Type/label assigned to the output artifact (e.g. clean_sample)
        type: string

      output_description:
        description: A brief description of the output artifact and the cleaning applied
        type: string

      min_price:
        description: Minimum price threshold; rows with a price below this value are dropped as outliers
        type: string

      max_price:
        description: Maximum price threshold; rows with a price above this value are dropped as outliers
        type: string


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
